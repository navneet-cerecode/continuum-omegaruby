# Copy to ignored .env.cloud. This template creates no services or paid resources.
CONTINUUM_ENV=cloud
CONTINUUM_PUBLIC_ORIGIN=https://YOUR-APP.up.railway.app
CONTINUUM_ACCESS=accounts
CONTINUUM_COOKIE_SECURE=true
# Private secret variable containing the manage-accounts.py JSON (hashes, never plaintext passwords).
CONTINUUM_ACCOUNTS_JSON=
FALKORDB_HOST=falkordb.railway.internal
FALKORDB_PORT=6379
FALKORDB_GRAPH=continuum_cloud_demo
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
# Keep false only on the same provider's private network; use true for a TLS endpoint.
FALKORDB_TLS=false
LLM_API_STYLE=chat_completions
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
