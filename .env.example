FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_GRAPH=continuum
# Verified free local alternative: install Ollama, ollama pull llama3, then set
# LLM_MODEL=llama3:latest, LLM_BASE_URL=http://127.0.0.1:11434, LLM_API_STYLE=ollama_json.
# No API key is needed in local Ollama mode.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# ollama_json, ollama, responses or chat_completions; match your model.
LLM_API_STYLE=responses
# demo is an explicit loopback synthetic workspace; accounts requires provisioned users.
CONTINUUM_ACCESS=demo
CONTINUUM_ACCOUNTS_FILE=.runtime/accounts.json
# true only behind HTTPS; keep false for the loopback HTTP development app.
CONTINUUM_COOKIE_SECURE=false
